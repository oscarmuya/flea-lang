// ---- Arithmetic ----
make x be 10;
make y be 5;

print x + y;
// EXPECTED: 15

print x - y;
// EXPECTED: 5

print x * y;
// EXPECTED: 50

print x / y;
// EXPECTED: 2

// ---- Comparison (single, non-chained) ----
print x > y;
// EXPECTED: true

print x < y;
// EXPECTED: false

print x >= 10;
// EXPECTED: true

print x <= y;
// EXPECTED: false

// ---- Equality ----
print x == y;
// EXPECTED: false

make same be x == x;
print same;
// EXPECTED: true

// ---- Unary ----
print -x;
// EXPECTED: -10

make eq be x == y;
print !eq;
// EXPECTED: true

// ---- Assignment as expression (right-associative, chainable) ----
make z be 0;
z be x be 20;

print z;
// EXPECTED: 20

print x;
// EXPECTED: 20

// ---- should / should ----
should (x > y) {
  print x;
  // EXPECTED: 20
} then {
  print y;
}

should (x < y) {
  print x;
} then {
  print y;
  // EXPECTED: 5
}

// ---- whilst loop: sum 1 to 5 ----
make i be 1;
make sum be 0;
whilst (i <= 5) {
  sum be sum + i;
  i be i + 1;
}

print sum;
// EXPECTED: 15

// ---- Nested block scoping ----
make a be 1;
{
  make a be 2;
  print a;
  // EXPECTED: 2
}

print a;
// EXPECTED: 1

// ---- Strings ----
make s be "hello";
print s;
// EXPECTED: hello

print s == "hello";
// EXPECTED: true
